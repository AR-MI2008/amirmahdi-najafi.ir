{
  "name": "amirmahdi-najafi-ir",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:ops && npm run build",
    "build:turbopack": "next build --turbopack",
    "test:cms": "npm run build && playwright test --config=playwright.cms.config.ts",
    "test:ops": "node --test tests/operations/*.test.mjs",
    "cms:preflight": "node --env-file=.env.production scripts/cms-preflight.mjs",
    "cms:backup": "node --env-file=.env.production scripts/cms-backup.mjs",
    "cms:restore": "node scripts/cms-restore.mjs",
    "cms:init": "node --env-file=.env.production scripts/cms-init.mjs",
    "cms:export-seed": "node scripts/cms-export-seed.mjs",
    "cms:import": "node --env-file=.env.production scripts/cms-import.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
