# ---------------------------------------------------------------------------
# amirmahdi-najafi.ir — environment
#
# Copy to .env.local for development, or set these in the systemd unit /
# platform dashboard in production. Never commit a filled-in copy.
#
# Validation lives in src/lib/env.ts and runs at server start via
# src/instrumentation.ts. A production server will refuse to boot with a
# readable list of problems rather than failing on a visitor's request.
# ---------------------------------------------------------------------------

# --- required, everywhere ---------------------------------------------------

# Public origin. No trailing slash. Must be https:// in production.
# Every canonical URL, hreflang entry, sitemap URL and OG image derives from it.
NEXT_PUBLIC_SITE_URL=https://amirmahdi-najafi.ir


# --- required in production -------------------------------------------------

# Mail delivery (Resend). Without BOTH of these the contact endpoint returns
# 503 in production and the server refuses to start. It will NOT quietly
# accept and discard messages.
EMAIL_API_KEY=
EMAIL_FROM=noreply@amirmahdi-najafi.ir

# Pepper for hashing client identifiers in the rate limiter. 32+ random chars:
#   openssl rand -base64 32
# Raw IPs are never stored; this is what makes the stored hash irreversible.
RATE_LIMIT_PEPPER=


# --- optional ---------------------------------------------------------------

# Where enquiries are delivered. Defaults to the address in src/content/site.ts.
CONTACT_DESTINATION=

# Cloudflare Turnstile. Set ALL THREE or NONE — the server rejects a
# partial configuration at boot, because a secret without a site key means the
# backend demands a token no client is producing and every submission fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hostnames Cloudflare is allowed to report in a Siteverify result.
# Comma-separated, so staging can have its own:
#   TURNSTILE_ALLOWED_HOSTNAMES=amirmahdi-najafi.ir,staging.amirmahdi-najafi.ir
#
# Required whenever Turnstile is enabled — verification fails closed without it.
# Configured server-side on purpose: the request Host header is
# attacker-controlled, so it cannot be the source of this allowlist.
# Development may add localhost explicitly. Production may not: a loopback
# entry would let a token solved on a local build satisfy the live site.
TURNSTILE_ALLOWED_HOSTNAMES=amirmahdi-najafi.ir

# Distributed rate limiting over an Upstash-compatible Redis REST API.
# REQUIRED if the app ever runs as more than one process: the default
# in-memory limiter degrades silently across instances. Set BOTH or NEITHER.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=

# Raises the GitHub API limit from 60 to 5000 requests/hour. Without it the
# homepage repository section simply hides itself when rate limited.
# A fine-grained token with NO scopes is sufficient — it only reads public data.
GITHUB_TOKEN=


# --- HSTS -------------------------------------------------------------------
# Read the HSTS section of docs/DEPLOYMENT.md before changing these.
# Default: max-age=31536000 on the apex only.

HSTS_MAX_AGE=31536000

# Only after EVERY subdomain — current and future — serves valid HTTPS.
# Irreversible for the max-age duration in any browser that has seen it.
HSTS_INCLUDE_SUBDOMAINS=false

# Only after a successful hstspreload.org submission. Requires the above.
HSTS_PRELOAD=false


# --- not active -------------------------------------------------------------
# Payload CMS is NOT installed (see docs/CMS.md). These are placeholders for
# the phase-2 migration and are ignored today.
# DATABASE_URL=
# PAYLOAD_SECRET=
